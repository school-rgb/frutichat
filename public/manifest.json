* {
  box-sizing: border-box;
}

:root {
  --bg: #0b1220;
  --panel: #121b2b;
  --panel-strong: #171f30;
  --surface: #1d2940;
  --accent: #7c9cff;
  --accent-soft: rgba(124, 156, 255, 0.16);
  --text: #edf3ff;
  --muted: #9bb0d3;
  --border: rgba(255, 255, 255, 0.08);
  --success: #66d49d;
  --danger: #ff7a7a;
}

body {
  margin: 0;
  font-family: Inter, system-ui, -apple-system, sans-serif;
  background: linear-gradient(180deg, #0a1322 0%, #0d1728 100%);
  color: var(--text);
  min-height: 100vh;
}

button,
input,
textarea {
  font: inherit;
}

#auth-shell {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
}

.auth-card {
  width: min(440px, 100%);
  background: rgba(18, 27, 43, 0.96);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 28px;
  box-shadow: 0 30px 60px rgba(0, 0, 0, 0.28);
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 24px;
}

.logo {
  width: 48px;
  height: 48px;
  border-radius: 14px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #7c9cff, #8be9fd);
  color: #0b1220;
  font-weight: 700;
  font-size: 1.5rem;
}

.logo.mini {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  font-size: 1.1rem;
}

.auth-tabs {
  display: flex;
  gap: 8px;
  margin-bottom: 18px;
}

.auth-tab {
  flex: 1;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: transparent;
  color: var(--muted);
  padding: 10px;
  cursor: pointer;
}

.auth-tab.active {
  background: var(--accent-soft);
  color: var(--text);
  border-color: rgba(124, 156, 255, 0.5);
}

.auth-form {
  display: none;
  gap: 14px;
}

.auth-form.active {
  display: grid;
}

.auth-form label {
  display: grid;
  gap: 8px;
  color: var(--muted);
  font-size: 0.92rem;
}

.auth-form input {
  border-radius: 10px;
  border: 1px solid var(--border);
  background: rgba(255,255,255,0.02);
  color: var(--text);
  padding: 12px 14px;
}

.auth-form button,
.send-button,
.ghost-button {
  border: none;
  border-radius: 10px;
  padding: 12px 14px;
  cursor: pointer;
  transition: 0.2s ease;
}

.auth-form button,
.send-button {
  background: linear-gradient(135deg, #7c9cff, #66d49d);
  color: #07111f;
  font-weight: 700;
}

.app-shell {
  display: grid;
  grid-template-columns: 320px minmax(0, 1fr);
  min-height: 100vh;
}

.sidebar {
  background: rgba(10, 14, 20, 0.7);
  border-right: 1px solid var(--border);
  padding: 14px;
}

.sidebar-header,
.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 10px 4px 14px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
}

.brand h2,
.chat-header-user h3 {
  margin: 0;
}

.ghost-button {
  background: rgba(255,255,255,0.03);
  color: var(--text);
  border: 1px solid var(--border);
}

.ghost-button.danger {
  color: #ffd3d3;
  border-color: rgba(255, 122, 122, 0.5);
  margin-left: 8px;
}

.search-box {
  margin-bottom: 14px;
}

.search-box input {
  width: 100%;
  background: rgba(255,255,255,0.02);
  border: 1px solid var(--border);
  color: var(--text);
  border-radius: 12px;
  padding: 10px 12px;
}

.conversation-list {
  display: grid;
  gap: 10px;
}

.conversation-item {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 14px;
  padding: 10px;
  color: var(--text);
  text-align: left;
  cursor: pointer;
}

.conversation-item.active {
  background: rgba(124, 156, 255, 0.16);
  border-color: rgba(124, 156, 255, 0.3);
}

.avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #7c9cff, #66d49d);
  color: #06131e;
  font-weight: 700;
}

.avatar.large {
  width: 46px;
  height: 46px;
}

.summary {
  min-width: 0;
  flex: 1;
}

.summary .line {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  font-weight: 600;
}

.summary small,
.chat-header-user small {
  color: var(--muted);
}

.chat-panel {
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto;
  min-width: 0;
}

.chat-header {
  padding: 18px 22px 12px;
  border-bottom: 1px solid var(--border);
}

.chat-header-user {
  display: flex;
  align-items: center;
  gap: 12px;
}

.chat-actions {
  display: flex;
  gap: 8px;
}

.icon-button {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(255,255,255,0.04);
  border: 1px solid var(--border);
  color: var(--text);
  cursor: pointer;
}

.message-list {
  overflow-y: auto;
  padding: 20px 22px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.message {
  display: flex;
}

.message.me {
  justify-content: flex-end;
}

.message .bubble {
  max-width: min(70%, 640px);
  border-radius: 18px;
  padding: 10px 12px;
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--border);
}

.message.me .bubble {
  background: linear-gradient(135deg, rgba(124,156,255,0.3), rgba(102,212,157,0.15));
}

.message-body {
  white-space: pre-wrap;
  word-break: break-word;
}

.message small {
  display: block;
  color: var(--muted);
  margin-top: 6px;
}

.composer {
  display: flex;
  align-items: center;
  gap: 10px;
  border-top: 1px solid var(--border);
  padding: 12px 18px 18px;
}

.composer textarea {
  flex: 1;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: rgba(255,255,255,0.02);
  color: var(--text);
  min-height: 48px;
  max-height: 150px;
  padding: 12px 14px;
  resize: vertical;
}

.composer-button {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: rgba(255,255,255,0.04);
  border: 1px solid var(--border);
  color: var(--text);
  cursor: pointer;
}

.empty-state {
  color: var(--muted);
  padding: 16px 10px;
}

@media (max-width: 820px) {
  .app-shell {
    grid-template-columns: 1fr;
  }

  .sidebar {
    border-right: none;
    border-bottom: 1px solid var(--border);
  }

  .chat-panel {
    min-height: 70vh;
  }
}
